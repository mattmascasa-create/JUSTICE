  "categories": ["legal", "security", "utilities"],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "🔴 RECORD NOW",
      "short_name": "Record",
      "description": "Start recording immediately",
      "url": "/quick-record",
      "icons": [{ "src": "/icons/record-icon.png", "sizes": "96x96" }]
    },
    {
      "name": "Emergency SOS",
      "short_name": "SOS",
      "description": "Activate emergency alert",
      "url": "/sos",
      "icons": [{ "src": "/icons/sos-icon.png", "sizes": "96x96" }]
    },
    {
      "name": "AI Attorney",
      "short_name": "AI Help",
      "description": "Get AI legal assistance",
      "url": "/ai-attorney",
      "icons": [{ "src": "/icons/ai-icon.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "audio/*", "image/*"]
        }
      ]
    }
  },
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-new"
  }
}
